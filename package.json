    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright-core": "^1.64.1",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
